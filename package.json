{
  "name": "@nebutra/notifications",
  "version": "0.1.3",
  "private": false,
  "license": "MIT",
  "type": "module",
  "nebutra": {
    "status": "stable",
    "productionReady": true,
    "requires": [
      "NOVU_API_KEY (managed)",
      "or Prisma-backed direct notification stores"
    ],
    "gaps": []
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./novu": {
      "types": "./dist/providers/novu.d.ts",
      "import": "./dist/providers/novu.js"
    },
    "./knock": {
      "types": "./dist/providers/knock.d.ts",
      "import": "./dist/providers/knock.js"
    },
    "./direct": {
      "types": "./dist/providers/direct.d.ts",
      "import": "./dist/providers/direct.js"
    },
    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "import": "./dist/prisma.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nebutra/logger": "file:./vendor/nebutra__logger",
    "@novu/node": "^2.0.0",
    "p-limit": "^7.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "@types/node": "^22.10.0"
  },
  "homepage": "https://github.com/Nebutra/notifications#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nebutra/notifications.git"
  },
  "bugs": {
    "url": "https://github.com/Nebutra/notifications/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "nebutraMirror": {
    "sourceRepository": "Nebutra/Nebutra-Sailor",
    "sourceDirectory": "packages/integrations/notifications",
    "sourcePackage": "@nebutra/notifications",
    "sourceSha": "9c39bed5bc7249f9051d673f6afad33e6216c6f7",
    "canonicalSource": "monorepo"
  },
  "packageManager": "pnpm@10.32.1"
}
